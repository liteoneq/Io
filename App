    private void applyImageShape(AndroidViewComponent imageComp, boolean isCircle, float cornerRadiusDp) {
        try {
            final View view = getAndroidView(imageComp);
            if (view != null && Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
                final float density = this.form.deviceDensity();
                view.setClipToOutline(true);
                view.setOutlineProvider(new ViewOutlineProvider() {
                    @Override
                    public void getOutline(View v, Outline outline) {
                        if (isCircle) {
                            int radius = Math.min(v.getWidth(), v.getHeight()) / 2;
                            outline.setRoundRect(0, 0, v.getWidth(), v.getHeight(), radius);
                        } else {
                            outline.setRoundRect(0, 0, v.getWidth(), v.getHeight(), dpToPx((int) cornerRadiusDp, density));
                        }
                    }
                });
            }
        } catch (Exception e) { e.printStackTrace(); }
    }

