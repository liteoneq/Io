    @SimpleFunction(description = "Creates a dynamic Button inside an Arrangement.")
    public void CreateButton(String id, Component arrangement) {
        validateId(id);
        if (arrangement == null) throw new YailRuntimeError("Arrangement cannot be null", TAG);
        ComponentContainer parent = asContainer(arrangement, "Arrangement");
        DeleteButton(id);
        try {
            AndroidViewComponent button = dynCreate(parent, "Button");
            setSingleProp(button, "BackgroundColor", Integer.valueOf(this.defaultButtonBackgroundColor));
            this.BUTTONS.put(id, button);
            makeButtonClickable(button, id);
        } catch (Exception e) {
            throw new YailRuntimeError("CreateButton failed: " + safeMessage(e), TAG);
        }
    }

    @SimpleFunction(description = "Deletes a dynamic Button.")
    public void DeleteButton(String id) {
        if (id == null) return;
        AndroidViewComponent button = this.BUTTONS.remove(id);
        if (button != null) removeComponentFromParent(button);
    }

