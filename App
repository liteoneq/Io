                    makeLabelClickable(fixedLabel1, id, "fixed1", fixedText1);
                }
                if (fixedText2 != null && !fixedText2.isEmpty()) {
                    AndroidViewComponent fixedLabel2 = dynLabel(fixedContainer, fixedFontSize2, isBold2, fixedColor2, fixedText2);
                    components.fixedText2 = fixedLabel2;
                    components.fixedText2Value = fixedText2;
                    components.fixedText2Size = fixedFontSize2;
                    components.fixedText2Color = fixedColor2;
                    components.fixedText2Bold = isBold2;
