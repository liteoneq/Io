    @SimpleFunction(description = "Configures and attaches an Image to an Advanced Button.")
    public void SetupAdvancedButtonImage(String id, String imagePath, int imageWidth, int imageHeight, int imageCornerRadius) {
        validateId(id);
        AdvancedButtonComponents components = this.ADVANCED_BUTTON_DATA.get(id);
        if (components != null && components.card != null) {
            try {
                ComponentContainer cardContainer = asContainer(components.card, "MakeroidCardView");
                if (components.image != null) removeComponentFromParent(components.image);
                if (imagePath != null && !imagePath.isEmpty()) {
                    AndroidViewComponent image = dynCreate(cardContainer, "Image");
                    setSingleProp(image, "Picture", imagePath);
                    setSingleProp(image, "Width", Integer.valueOf(imageWidth));
                    setSingleProp(image, "Height", Integer.valueOf(-2));
                    if (imageCornerRadius > 0) applyImageShape(image, imageWidth == imageHeight, imageCornerRadius);
                    components.image = image;
                    AssembleAdvancedButtonLayout(id, components.layoutDirection);
                }
            } catch (Exception e) { e.printStackTrace(); }
        }
    }

