    @SimpleFunction(description = "Creates a dynamic Card.")
    public void CreateCard(String id, Component arrangement) {
        validateId(id);
        if (arrangement == null) throw new YailRuntimeError("Arrangement cannot be null", TAG);
        ComponentContainer parent = asContainer(arrangement, "Arrangement");
        try {
            DeleteCard(id);
            HashMap<String, AndroidViewComponent> labelsMap = new HashMap<>();
            HashMap<String, Boolean> visibilityMap = new HashMap<>();
            AndroidViewComponent cardView = createBaseCardView(parent, id, labelsMap, visibilityMap);
            this.CARDS.put(id, cardView);
            this.CARD_TEXTS.put(id, labelsMap);
            this.CARD_TEXT_VISIBILITY.put(id, visibilityMap);
            this.CARD_ORIGINAL_COLORS.put(id, Integer.valueOf(this.defaultCardBackgroundColor));
            SetCardClickMode(id, 1);
        } catch (Exception e) {
            throw new YailRuntimeError("CreateCard failed: " + safeMessage(e), TAG);
        }
    }

    @SimpleFunction(description = "Deletes a dynamic Card.")
