    @SimpleFunction(description = "Sets the layout orientation.")
    public void SetCardOrientation(String id, boolean isHorizontal) {
        validateId(id);
        AndroidViewComponent currentContainer = this.CARD_COLUMNS.get(id);
        AndroidViewComponent card = this.CARDS.get(id);
        HashMap<String, AndroidViewComponent> labels = this.CARD_TEXTS.get(id);
        AndroidViewComponent imageComp = this.CARD_IMAGES.get(id);
        if (card != null && currentContainer != null && labels != null) {
            try {
                ComponentContainer cardContainer = asContainer(card, "MakeroidCardView");
                String targetType = isHorizontal ? "HorizontalArrangement" : "VerticalArrangement";
                AndroidViewComponent newContainer = dynCreate(cardContainer, targetType);
                setSingleProp(newContainer, "AlignHorizontal", Integer.valueOf(1));
                setSingleProp(newContainer, "AlignVertical", Integer.valueOf(1));
                setSingleProp(newContainer, "Width", Integer.valueOf(-2));
                setSingleProp(newContainer, "Height", Integer.valueOf(-2));
                if (imageComp != null) moveComponentToNewParent(imageComp, newContainer);
                for (AndroidViewComponent label : labels.values()) { if (label != null) moveComponentToNewParent(label, newContainer); }
                removeComponentFromParent(currentContainer);
                this.CARD_COLUMNS.put(id, newContainer);
            } catch (Exception e) { throw new YailRuntimeError("SetCardOrientation failed: " + safeMessage(e), TAG); }
        }
    }

    @SimpleFunction(description = "Enables or disables scrolling for a Card.")
    public void SetCardScrollEnabled(String id, boolean enabled) {
        validateId(id);
        AndroidViewComponent card = this.CARDS.get(id);
        if (card != null) {
            try {
                View cardView = getAndroidView(card);
                if (cardView instanceof ViewGroup) {
                    ViewGroup cardGroup = (ViewGroup) cardView;
                    if (enabled) {
                        if (cardGroup.getChildCount() > 0 && cardGroup.getChildAt(0) instanceof android.widget.ScrollView) return;
                        android.widget.ScrollView scrollView = new android.widget.ScrollView(this.form);
                        scrollView.setLayoutParams(new ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
                        scrollView.setFillViewport(true);
                        if (cardGroup.getChildCount() > 0) {
                            View content = cardGroup.getChildAt(0);
                            cardGroup.removeView(content);
                            scrollView.addView(content);
                        }
                        cardGroup.addView(scrollView);
                    } else {
                        if (cardGroup.getChildCount() > 0 && cardGroup.getChildAt(0) instanceof android.widget.ScrollView) {
                            android.widget.ScrollView sv = (android.widget.ScrollView) cardGroup.getChildAt(0);
                            if (sv.getChildCount() > 0) {
                                View orig = sv.getChildAt(0);
                                cardGroup.removeView(sv);
                                cardGroup.addView(orig);
                            }
                        }
                    }
                }
            } catch (Exception e) { e.printStackTrace(); }
        }
    }

