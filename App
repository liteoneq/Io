    private static void validateId(String id) {
        if (id == null || id.trim().isEmpty()) throw new YailRuntimeError("Component id cannot be empty", TAG);
    }

    private static ComponentContainer asContainer(Component component, String name) {
        if (!(component instanceof ComponentContainer)) throw new YailRuntimeError(name + " must be a visible Arrangement component.", TAG);
        return (ComponentContainer) component;
    }

    private static View getAndroidView(AndroidViewComponent component) throws Exception {
        Method method = component.getClass().getMethod("getView");
        Object result = method.invoke(component);
        if (!(result instanceof View)) throw new IllegalStateException("getView() did not return a View");
        return (View) result;
    }

    private static void removeComponentFromParent(AndroidViewComponent component) {
        if (component == null) return;
        try {
            View view = getAndroidView(component);
            if (view != null) {
                ViewGroup parent = (ViewGroup) view.getParent();
                if (parent != null) parent.removeView(view);
            }
        } catch (Exception e) { e.printStackTrace(); }
    }

    private static void setComponentVisible(AndroidViewComponent component, boolean visible) {
        if (component == null) return;
        try {
            View view = getAndroidView(component);
            if (view != null) view.setVisibility(visible ? View.VISIBLE : View.GONE);
        } catch (Exception e) { e.printStackTrace(); }
    }

    private static void moveComponentToNewParent(AndroidViewComponent component, AndroidViewComponent newParentContainer) {
        try {
            View view = getAndroidView(component);
            if (view != null) {
                ViewGroup parentGroup = (ViewGroup) view.getParent();
                if (parentGroup != null) parentGroup.removeView(view);
                View newParentView = getAndroidView(newParentContainer);
                if (newParentView instanceof ViewGroup) ((ViewGroup) newParentView).addView(view);
            }
        } catch (Exception e) { e.printStackTrace(); }
    }

    private static AndroidViewComponent dynCreate(ComponentContainer parent, String name) throws Exception {
        if (parent == null) throw new YailRuntimeError("Parent container cannot be null", TAG);
        Class<?> cls = findClass(name);
        Constructor<?> constructor = cls.getConstructor(ComponentContainer.class);
        Object result = constructor.newInstance(parent);
        if (!(result instanceof AndroidViewComponent)) throw new YailRuntimeError("Component is not AndroidViewComponent: " + name, TAG);
        return (AndroidViewComponent) result;
    }

    private static void setSingleProp(Object component, String propertyName, Object value) {
        if (component != null && propertyName != null) dynProp(component, propertyName, value);
    }

    private static void dynProp(Object component, String propertyName, Object value) {
        if (component == null || propertyName == null) return;
        Method[] methods = component.getClass().getMethods();
        for (Method method : methods) {
            if (!method.getName().equals(propertyName)) continue;
            if (method.getParameterTypes().length != 1) continue;
            try {
                method.invoke(component, value);
                return;
            } catch (Exception e) { }
        }
    }

    private static Class<?> findClass(String name) {
        String[] packages = {"com.google.appinventor.components.runtime.", "io.makeroid.components.", "com.niotron.components.", "io.kodular.components."};
        for (String packageName : packages) {
            try { return Class.forName(packageName + name); } catch (ClassNotFoundException e) { }
        }
        throw new YailRuntimeError("Component not found: " + name, TAG);
    }

    private static String safeMessage(Exception exception) {
        if (exception == null) return "Unknown error";
        String message = exception.getMessage();
        return (message == null || message.isEmpty()) ? exception.getClass().getSimpleName() : message;
    }

    private void makeButtonClickable(final AndroidViewComponent component, final String id) {
        if (component == null) return;
        try {
            View view = getAndroidView(component);
            if (view == null) throw new IllegalStateException("Button View is null");
            view.setClickable(true); view.setFocusable(true);
            view.setOnClickListener(new View.OnClickListener() { @Override public void onClick(View v) { ButtonClick(id); } });
        } catch (Exception e) { throw new YailRuntimeError("Click listener error: " + safeMessage(e), TAG); }
    }

    private void makeAdvancedButtonClickable(final String id) {
        AdvancedButtonComponents components = this.ADVANCED_BUTTON_DATA.get(id);
        if (components == null || components.card == null) return;
        try {
            final View view = getAndroidView(components.card);
            if (view == null) return;
            view.setClickable(true); view.setFocusable(true);
            if (this.defaultAdvancedButtonRippleEnabled && Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
                android.util.TypedValue outValue = new android.util.TypedValue();
                this.form.$context().getTheme().resolveAttribute(android.R.attr.selectableItemBackground, outValue, true);
                view.setForeground(this.form.$context().getDrawable(outValue.resourceId));
            }
            view.setOnClickListener(new View.OnClickListener() {
                @Override
                public void onClick(View v) {
                    if (components.clickFeedbackEnabled) animateButtonClick(id);
                    AdvancedButtonClick(id);
                }
            });
        } catch (Exception e) { e.printStackTrace(); }
    }

    private void animateButtonClick(final String id) {
        AdvancedButtonComponents components = this.ADVANCED_BUTTON_DATA.get(id);
        if (components == null || components.card == null) return;
        try {
            final View view = getAndroidView(components.card);
            if (view == null) return;
            final int duration = this.defaultAdvancedButtonClickAnimationDuration;
            view.animate().scaleX(0.95f).scaleY(0.95f).setDuration(duration).withEndAction(new Runnable() {
                @Override public void run() { view.animate().scaleX(1.0f).scaleY(1.0f).setDuration(duration).start(); }
            }).start();
            int originalColor = components.originalBackgroundColor;
            int pressedColor = darkenColor(originalColor);
            setSingleProp(components.card, "BackgroundColor", Integer.valueOf(pressedColor));
            view.postDelayed(new Runnable() {
                @Override public void run() { setSingleProp(components.card, "BackgroundColor", Integer.valueOf(originalColor)); }
            }, duration * 2);
        } catch (Exception e) { e.printStackTrace(); }
    }

    private void animateCardClick(final String id) {
        AndroidViewComponent card = this.CARDS.get(id);
        if (card == null) return;
        try {
            final View view = getAndroidView(card);
            if (view == null) return;
            final int duration = this.defaultAdvancedButtonClickAnimationDuration;
            view.animate().scaleX(0.95f).scaleY(0.95f).setDuration(duration).withEndAction(new Runnable() {
                @Override public void run() { view.animate().scaleX(1.0f).scaleY(1.0f).setDuration(duration).start(); }
            }).start();
            Integer originalColorObj = this.CARD_ORIGINAL_COLORS.get(id);
            if (originalColorObj != null) {
                int originalColor = originalColorObj.intValue();
                int pressedColor = darkenColor(originalColor);
                setSingleProp(card, "BackgroundColor", Integer.valueOf(pressedColor));
                view.postDelayed(new Runnable() {
                    @Override public void run() { setSingleProp(card, "BackgroundColor", Integer.valueOf(originalColor)); }
                }, duration * 2);
            }
        } catch (Exception e) { e.printStackTrace(); }
    }

    private static int darkenColor(int color) {
        float[] hsv = new float[3];
        android.graphics.Color.colorToHSV(color, hsv);
        hsv[2] *= 0.8f;
        return android.graphics.Color.HSVToColor(hsv);
    }

