    @SimpleFunction(description = "Assembles the layout based on current direction.")
    public void AssembleAdvancedButtonLayout(String id, int direction) {
        validateId(id);
        AdvancedButtonComponents components = this.ADVANCED_BUTTON_DATA.get(id);
        if (components != null && components.card != null) {
            try {
                ComponentContainer cardContainer = asContainer(components.card, "MakeroidCardView");
                if (components.container != null) removeComponentFromParent(components.container);
                AndroidViewComponent container = createLayout(cardContainer, components.image, components.mainText, components.fixedLayout, direction, components.verticalTextGap, components.textAlignment);
                components.container = container;
            } catch (Exception e) { e.printStackTrace(); }
        }
    }

    @SimpleFunction(description = "Sets the layout direction of elements. 0=Left, 1=Right, 2=Top, 3=Bottom.")
    public void SetAdvancedButtonLayoutDirection(String id, int direction) {
        validateId(id);
        AdvancedButtonComponents components = this.ADVANCED_BUTTON_DATA.get(id);
        if (components != null) {
            components.layoutDirection = Math.max(0, Math.min(3, direction));
            AssembleAdvancedButtonLayout(id, components.layoutDirection);
        }
    }

    @SimpleFunction(description = "Sets the text alignment only (0=Left, 1=Center, 2=Right). Does not affect image position.")
    public void SetAdvancedButtonTextAlignment(String id, int alignment) {
        validateId(id);
        AdvancedButtonComponents components = this.ADVANCED_BUTTON_DATA.get(id);
        if (components != null) {
            components.textAlignment = Math.max(0, Math.min(2, alignment));
            if (components.mainText != null) {
                setSingleProp(components.mainText, "TextAlignment", Integer.valueOf(components.textAlignment));
            }
            if (components.fixedLayout != null) {
                setSingleProp(components.fixedLayout, "AlignHorizontal", Integer.valueOf(components.textAlignment == 0 ? 1 : (components.textAlignment == 2 ? 2 : 1)));
            }
        }
    }

    @SimpleFunction(description = "Sets the click behavior for the advanced button. 1=Full Surface, 2=Texts Only, 3=Mixed.")
    public void SetAdvancedButtonClickMode(String id, int mode) {
        validateId(id);
        AdvancedButtonComponents components = this.ADVANCED_BUTTON_DATA.get(id);
        if (components != null && components.card != null) {
            try {
                View rootView = getAndroidView(components.card);
                if (rootView == null) return;
                if (mode == 1) {
                    rootView.setClickable(true); rootView.setFocusable(true);
                    if (this.defaultAdvancedButtonRippleEnabled && Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
                        android.util.TypedValue outValue = new android.util.TypedValue();
                        this.form.$context().getTheme().resolveAttribute(android.R.attr.selectableItemBackground, outValue, true);
                        rootView.setForeground(this.form.$context().getDrawable(outValue.resourceId));
                    }
                    rootView.setOnClickListener(new View.OnClickListener() { 
                        @Override public void onClick(View v) { animateButtonClick(id); AdvancedButtonClick(id); } 
                    });
                    disableClickRecursively(rootView);
                } else if (mode == 2) {
                    rootView.setClickable(false); rootView.setFocusable(false); rootView.setOnClickListener(null);
                    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) rootView.setForeground(null);
                    enableClickRecursively(rootView, new View.OnClickListener() { @Override public void onClick(View v) {} });
                } else {
                    rootView.setClickable(true); rootView.setFocusable(true);
                    if (this.defaultAdvancedButtonRippleEnabled && Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
                        android.util.TypedValue outValue = new android.util.TypedValue();
