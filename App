                setSingleProp(fixedLayout, "AlignVertical", Integer.valueOf(1));
                setSingleProp(fixedLayout, "Width", Integer.valueOf(-2));
                setSingleProp(fixedLayout, "Height", Integer.valueOf(-2));
                setSingleProp(fixedLayout, "ContentPaddingLeft", Integer.valueOf(10));
                setSingleProp(fixedLayout, "ContentPaddingRight", Integer.valueOf(10));
                components.fixedLayout = fixedLayout;
                
                ComponentContainer fixedContainer = asContainer(fixedLayout, "HorizontalArrangement");
                if (fixedText1 != null && !fixedText1.isEmpty()) {
                    AndroidViewComponent fixedLabel1 = dynLabel(fixedContainer, fixedFontSize1, isBold1, fixedColor1, fixedText1);
                    components.fixedText1 = fixedLabel1;
                    components.fixedText1Value = fixedText1;
