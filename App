    @SimpleFunction(description = "Creates an advanced button with image, main text and two fixed texts.")
    public void CreateAdvancedButton(String id, Component arrangement, String imagePath, String mainText, String fixedText1, String fixedText2) {
        validateId(id);
        if (arrangement == null) throw new YailRuntimeError("Arrangement cannot be null.", TAG);
        try {
            ComponentContainer parent = asContainer(arrangement, "Arrangement");
            DeleteAdvancedButton(id);
            AndroidViewComponent card = dynCreate(parent, "MakeroidCardView");
            setSingleProp(card, "Width", Integer.valueOf(this.defaultAdvancedButtonWidth));
            setSingleProp(card, "Height", Integer.valueOf(this.defaultAdvancedButtonHeight));
            setSingleProp(card, "BackgroundColor", Integer.valueOf(this.defaultAdvancedButtonBackgroundColor));
            setSingleProp(card, "CornerRadius", Integer.valueOf(this.defaultAdvancedButtonCornerRadius));
            setSingleProp(card, "ContentPaddingLeft", Integer.valueOf(this.defaultAdvancedButtonPadding));
            setSingleProp(card, "ContentPaddingRight", Integer.valueOf(this.defaultAdvancedButtonPadding));
            setSingleProp(card, "ContentPaddingTop", Integer.valueOf(this.defaultAdvancedButtonPadding));
            setSingleProp(card, "ContentPaddingBottom", Integer.valueOf(this.defaultAdvancedButtonPadding));
            
            AdvancedButtonComponents components = new AdvancedButtonComponents();
            components.card = card;
            components.originalBackgroundColor = this.defaultAdvancedButtonBackgroundColor;
            this.ADVANCED_BUTTONS.put(id, card);
            this.ADVANCED_BUTTON_DATA.put(id, components);
            
            if (mainText != null && !mainText.isEmpty()) {
                SetupAdvancedButtonMainText(id, mainText, this.defaultAdvancedButtonMainTextSize, this.defaultAdvancedButtonMainTextColor, 0, true);
            }
            if (fixedText1 != null || fixedText2 != null) {
                SetupAdvancedButtonFixedTexts(id, fixedText1, fixedText2, this.defaultAdvancedButtonFixedTextSize, this.defaultAdvancedButtonFixedTextColor, false, this.defaultAdvancedButtonFixedTextSize, this.defaultAdvancedButtonFixedTextColor, false);
            }
            if (imagePath != null && !imagePath.isEmpty()) {
                SetupAdvancedButtonImage(id, imagePath, this.defaultAdvancedButtonImageWidth, this.defaultAdvancedButtonImageHeight, this.defaultAdvancedButtonImageCornerRadius);
            } else {
                AssembleAdvancedButtonLayout(id, 0);
            }
            makeAdvancedButtonClickable(id);
        } catch (Exception e) {
            throw new YailRuntimeError("CreateAdvancedButton failed: " + safeMessage(e), TAG);
        }
    }

