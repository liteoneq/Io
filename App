    // ============================================================
    // LAYOUT HELPERS FOR ADVANCED BUTTON
    // ============================================================
    private static AndroidViewComponent createLayout(ComponentContainer parent, AndroidViewComponent image, AndroidViewComponent mainLabel, AndroidViewComponent fixedLayout, int direction, int verticalGap, int textAlignment) throws Exception {
        switch (direction) {
            case 0: return createLeftLayout(parent, image, mainLabel, fixedLayout, verticalGap, textAlignment);
            case 1: return createRightLayout(parent, image, mainLabel, fixedLayout, verticalGap, textAlignment);
            case 2: return createTopLayout(parent, image, mainLabel, fixedLayout, verticalGap, textAlignment);
            case 3: return createBottomLayout(parent, image, mainLabel, fixedLayout, verticalGap, textAlignment);
            default: return createLeftLayout(parent, image, mainLabel, fixedLayout, verticalGap, textAlignment);
        }
    }

    private static AndroidViewComponent createTopLayout(ComponentContainer parent, AndroidViewComponent image, AndroidViewComponent mainLabel, AndroidViewComponent fixedLayout, int verticalGap, int textAlignment) throws Exception {
        AndroidViewComponent container = dynCreate(parent, "VerticalArrangement");
        setSingleProp(container, "AlignHorizontal", Integer.valueOf(1));
        setSingleProp(container, "AlignVertical", Integer.valueOf(1));
        setSingleProp(container, "Width", Integer.valueOf(-2));
        setSingleProp(container, "Height", Integer.valueOf(-2));
        ComponentContainer containerTop = asContainer(container, "VerticalArrangement");
        if (image != null) { moveComponentToNewParent(image, container); createSpacer(containerTop, 10); }
        AndroidViewComponent textLayout = dynCreate(containerTop, "VerticalArrangement");
        setSingleProp(textLayout, "AlignHorizontal", Integer.valueOf(textAlignment == 0 ? 1 : (textAlignment == 2 ? 2 : 1)));
        setSingleProp(textLayout, "AlignVertical", Integer.valueOf(1));
        setSingleProp(textLayout, "Width", Integer.valueOf(-2));
        setSingleProp(textLayout, "Height", Integer.valueOf(-2));
        ComponentContainer textContainer = asContainer(textLayout, "VerticalArrangement");
        if (mainLabel != null) { moveComponentToNewParent(mainLabel, textLayout); createSpacer(textContainer, verticalGap); }
        if (fixedLayout != null) moveComponentToNewParent(fixedLayout, textLayout);
        return container;
    }

    private static AndroidViewComponent createBottomLayout(ComponentContainer parent, AndroidViewComponent image, AndroidViewComponent mainLabel, AndroidViewComponent fixedLayout, int verticalGap, int textAlignment) throws Exception {
        AndroidViewComponent container = dynCreate(parent, "VerticalArrangement");
        setSingleProp(container, "AlignHorizontal", Integer.valueOf(1));
        setSingleProp(container, "AlignVertical", Integer.valueOf(1));
        setSingleProp(container, "Width", Integer.valueOf(-2));
        setSingleProp(container, "Height", Integer.valueOf(-2));
        ComponentContainer containerBottom = asContainer(container, "VerticalArrangement");
        AndroidViewComponent textLayout = dynCreate(containerBottom, "VerticalArrangement");
