    private void enableClickRecursively(View view, View.OnClickListener listener) {
        view.setOnClickListener(listener);
        if (view instanceof ViewGroup) {
            ViewGroup group = (ViewGroup) view;
            for (int i = 0; i < group.getChildCount(); i++) {
                enableClickRecursively(group.getChildAt(i), listener);
            }
        }
    }

    private void disableClickRecursively(View view) {
        view.setOnClickListener(null);
        if (view instanceof ViewGroup) {
            ViewGroup group = (ViewGroup) view;
            for (int i = 0; i < group.getChildCount(); i++) {
                disableClickRecursively(group.getChildAt(i));
            }
        }
    }

    public static int dpToPx(int dp, float density) {
        return Math.round(dp * density);
    }
